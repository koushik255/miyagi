# Only required by the Docker Compose/DigitalOcean deployment.
# Enter the Droplet's public IPv4 address without http:// or a path.
DROPLET_IP=203.0.113.10

# Create these at GitHub -> Settings -> Developer settings -> OAuth Apps.
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me

# Public OAuth callback. For a Cloudflare Tunnel, use its HTTPS hostname here,
# for example: https://miyagi.example.com/auth/github/callback
# Docker Compose overrides this value using DROPLET_IP.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
GITHUB_OAUTH_STATE_SECRET=replace-with-a-long-random-value

# GitHub username for the professor owner who manages access at /admin.
GITHUB_USERNAME=replace-with-owner-github-username
